# ==============================================================================
# A.E.G.I.S. (Academic Evaluation & Grant Integrity System)
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

APP_NAME="A.E.G.I.S."
APP_ENV=production
APP_KEY=                          # REQUIRED: Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-domain.clsu.edu.ph
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Master account administrative email (controls Director ownership & role gateway)
MASTER_ACCOUNT_EMAIL=admin@clsu.edu.ph

# Demo accounts & universal OTP bypass (MUST BE FALSE IN PRODUCTION)
ALLOW_DEMO_ACCOUNTS=false

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────
# LOGGING & SENTRY ERROR TRACKING
# ─────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Sentry Production Monitoring (https://sentry.io)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ─────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────
# Supported: pgsql (PostgreSQL/Supabase/Render) or mysql
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_secure_db_password
DB_SSLMODE=require

# ─────────────────────────────────────────────────────────────
# SESSIONS & CACHE
# ─────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# ─────────────────────────────────────────────────────────────
# CORS & NETWORKING
# ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend / API domains
CORS_ALLOWED_ORIGINS="https://your-domain.clsu.edu.ph,https://xyoul-aegis-ai.hf.space"

# ─────────────────────────────────────────────────────────────
# TRANSACTIONAL EMAIL (Brevo API or SMTP)
# ─────────────────────────────────────────────────────────────
# Use 'brevo_api' or standard 'smtp'
MAIL_MAILER=brevo_api
BREVO_API_KEY=your_brevo_api_key_here
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@clsu-aegis.ph
MAIL_FROM_NAME="A.E.G.I.S. - CLSU OSA"

# ─────────────────────────────────────────────────────────────
# CLOUD DOCUMENT STORAGE (Cloudflare R2 / AWS S3)
# ─────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local             # Use 'r2' or 's3' for multi-server production
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=aegis-documents
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_URL=https://pub-your-bucket-id.r2.dev

# ─────────────────────────────────────────────────────────────
# AI MICROSERVICE (Python Forensics & OCR Engine)
# ─────────────────────────────────────────────────────────────
# Production URL of the Flask / FastAPI AI microservice (e.g., HuggingFace Spaces)
AEGIS_AI_URL=https://xyoul-aegis-ai.hf.space

# ─────────────────────────────────────────────────────────────
# SYSTEM CRON / SCHEDULER ACCESS KEY
# ─────────────────────────────────────────────────────────────
SCHEDULER_KEY=generate_a_cryptographically_secure_random_token_here

# ─────────────────────────────────────────────────────────────
# ASSETS
# ─────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

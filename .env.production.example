APP_NAME="A.E.G.I.S."
APP_ENV=production
APP_KEY=                          # REQUIRED: Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com   # REQUIRED: Replace with your actual server domain/IP

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # Use 'error' in production (not 'debug')

# ─────────────────────────────────────────────────────────────
# DATABASE — Use MySQL in production (NOT SQLite)
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aegis_db              # REQUIRED: Create this database
DB_USERNAME=aegis_user            # REQUIRED: Set your DB username
DB_PASSWORD=                      # REQUIRED: Set a strong password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true              # Enable session encryption in production
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com  # REQUIRED: Match your domain

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database         # Uses DB queue; switch to Redis for high load

CACHE_STORE=database

# ─────────────────────────────────────────────────────────────
# MAIL — Configure real SMTP for email notifications
# ─────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com          # REQUIRED: Your SMTP host (Gmail, Mailgun, etc.)
MAIL_PORT=587
MAIL_USERNAME=                    # REQUIRED: Your SMTP email address
MAIL_PASSWORD=                    # REQUIRED: Your SMTP password or App Password
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="A.E.G.I.S. - OSA CLSU"

# ─────────────────────────────────────────────────────────────
# AI MICROSERVICE — Flask service URL
# ─────────────────────────────────────────────────────────────
AEGIS_AI_URL=http://127.0.0.1:5000  # URL of the running Flask AI microservice

# ─────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────
# Ensure your server has SSL/TLS (HTTPS) enabled
# All routes should be served over HTTPS only

VITE_APP_NAME="${APP_NAME}"

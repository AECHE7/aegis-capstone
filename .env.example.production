# ==============================================================================
# A.E.G.I.S. Zero-Cost Production Environment Template (.env.production)
# ==============================================================================

APP_NAME="A.E.G.I.S. CLSU"
APP_ENV=production
APP_KEY=  # Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-app.fly.dev

# ------------------------------------------------------------------------------
# Layer 1 & 3: Caching, Sessions, and Queues (Upstash Serverless Redis)
# ------------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=your-upstash-instance.upstash.io
REDIS_PASSWORD=your-upstash-redis-password
REDIS_PORT=6379
REDIS_SCHEME=tls  # Force secure TLS connection for remote Redis

# ------------------------------------------------------------------------------
# Layer 2: Database Layer (Supabase or Neon.tech Serverless Postgres)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=your-database-host.neon.tech
DB_PORT=6543  # Use PgBouncer Connection Pooling Port (6543) instead of 5432
DB_DATABASE=neondb
DB_USERNAME=alex
DB_PASSWORD=your-database-password
DB_SSLMODE=require

# Disable prepared statements in environment when using PgBouncer pooling
DB_EMULATE_PREPARES=true

# ------------------------------------------------------------------------------
# Layer 4: Private Cloud Storage (Cloudflare R2 - 10GB Free Tier)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=r2
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=aegis-documents
CLOUDFLARE_R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://your-bucket-public-or-custom-domain.com

# ------------------------------------------------------------------------------
# Layer 5: Observability & Resilience (Sentry Error Tracking - Free Tier)
# ------------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=  # Set your Sentry DSN to enable error/performance tracing
SENTRY_TRACE_QUEUE_ENABLED=true
SENTRY_TRACE_SQL_QUERIES_ENABLED=true
SENTRY_TRACE_CACHE_ENABLED=true

# ------------------------------------------------------------------------------
# Layer 6: Communications (Brevo Transaction Mailer - 300 Free/Day)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-registered-email@clsu.edu.ph
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@clsu.edu.ph"
MAIL_FROM_NAME="CLSU Scholarship Portal"
